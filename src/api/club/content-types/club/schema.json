{
  "kind": "collectionType",
  "collectionName": "clubs",
  "info": {
    "singularName": "club",
    "pluralName": "clubs",
    "displayName": "Club",
    "description": "Football club"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user"
    },
    "clubName": {
      "type": "string",
      "required": true
    },
    "country": {
      "type": "string",
      "required": false
    },
    "city": {
      "type": "string"
    },
    "league": {
      "type": "string"
    },
    "level": {
      "type": "enumeration",
      "required": false,
      "enum": ["amateur", "semi-pro", "pro"]
    },
    "logo": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "website": {
      "type": "string"
    },
    "contactEmail": {
      "type": "email"
    },
    "contactPhone": {
      "type": "string"
    },
    "verified": {
      "type": "boolean",
      "default": false
    },
    "recruitmentPosts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::recruitment-post.recruitment-post",
      "mappedBy": "club"
    }
  }
}
