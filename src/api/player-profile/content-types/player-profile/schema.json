{
  "kind": "collectionType",
  "collectionName": "player_profiles",
  "info": {
    "singularName": "player-profile",
    "pluralName": "player-profiles",
    "displayName": "Player Profile",
    "description": "Football player profile"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "user": {
      "type": "relation",
      "relation": "oneToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "playerProfile"
    },
    "firstName": {
      "type": "string",
      "required": true
    },
    "lastName": {
      "type": "string",
      "required": true
    },
    "heightCm": {
      "type": "integer",
      "min": 140,
      "max": 220
    },
    "weightKg": {
      "type": "integer",
      "min": 40,
      "max": 150
    },
    "preferredFoot": {
      "type": "enumeration",
      "default": "right",
      "enum": [
        "left",
        "right",
        "both"
      ]
    },
    "primaryPosition": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "GK",
        "CB",
        "LB",
        "RB",
        "CDM",
        "CM",
        "LM",
        "RM",
        "CAM",
        "LW",
        "RW",
        "ST",
        "CF"
      ]
    },
    "experienceLevel": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "youth",
        "amateur",
        "semi-pro",
        "pro"
      ]
    },
    "currentClub": {
      "type": "string"
    },
    "isFreeAgent": {
      "type": "boolean",
      "default": true
    },
    "availabilityFrom": {
      "type": "date"
    },
    "bio": {
      "type": "richtext"
    },
    "profilePhoto": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "visibility": {
      "type": "enumeration",
      "default": "clubs-only",
      "enum": [
        "public",
        "clubs-only",
        "private"
      ]
    },
    "formerClubs": {
      "type": "json"
    },
    "dateOfBirth": {
      "type": "date"
    },
    "secondaryPositions": {
      "type": "json"
    },
    "mediaLinks": {
      "type": "json"
    }
  }
}
