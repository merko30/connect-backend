{
  "kind": "collectionType",
  "collectionName": "recruitment_posts",
  "info": {
    "singularName": "recruitment-post",
    "pluralName": "recruitment-posts",
    "displayName": "Recruitment Post",
    "description": "Club recruitment post for player or coach roles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "type": {
      "type": "enumeration",
      "required": true,
      "default": "player",
      "enum": ["player", "coach"]
    },
    "club": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::club.club",
      "inversedBy": "recruitmentPosts"
    },
    "position": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "GK",
        "CB",
        "LB",
        "RB",
        "CDM",
        "CM",
        "LM",
        "RM",
        "CAM",
        "LW",
        "RW",
        "ST",
        "CF"
      ]
    },
    "coachType": {
      "type": "enumeration",
      "required": false,
      "enum": [
        "head-coach",
        "assistant-coach",
        "goalkeeping-coach",
        "fitness-coach",
        "analyst"
      ]
    },
    "note": {
      "type": "text"
    },
    "level": {
      "type": "enumeration",
      "required": false,
      "enum": ["youth", "amateur", "semi-pro", "pro"]
    },
    "categories": {
      "type": "json",
      "required": false
    },
    "postStatus": {
      "type": "enumeration",
      "default": "open",
      "enum": ["open", "paused", "closed"]
    },
    "deadline": {
      "type": "date"
    },
    "contractType": {
      "type": "enumeration",
      "required": true,
      "enum": ["trial", "short-term", "full-season", "permanent"]
    },
    "requirements": {
      "type": "text"
    },
    "interested": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "plugin::users-permissions.user"
    }
  }
}
