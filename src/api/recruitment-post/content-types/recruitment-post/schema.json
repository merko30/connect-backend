{
  "kind": "collectionType",
  "collectionName": "recruitment_posts",
  "info": {
    "singularName": "recruitment-post",
    "pluralName": "recruitment-posts",
    "displayName": "Recruitment Post",
    "description": "Club recruitment post for player positions"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "club": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::club.club",
      "inversedBy": "recruitmentPosts",
      "required": true
    },
    "position": {
      "type": "enumeration",
      "required": true,
      "enum": [
        "GK",
        "CB",
        "LB",
        "RB",
        "CDM",
        "CM",
        "LM",
        "RM",
        "CAM",
        "LW",
        "RW",
        "ST",
        "CF"
      ]
    },
    "note": {
      "type": "text"
    },
    "level": {
      "type": "enumeration",
      "enum": ["youth", "amateur", "semi-pro", "pro"]
    },
    "postStatus": {
      "type": "enumeration",
      "default": "open",
      "enum": ["open", "paused", "closed"]
    },
    "deadline": {
      "type": "date"
    },
    "contractType": {
      "type": "enumeration",
      "required": true,
      "enum": ["trial", "short-term", "full-season", "permanent"]
    },
    "requirements": {
      "type": "text"
    }
  }
}
